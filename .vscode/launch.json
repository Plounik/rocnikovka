{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SPIKE Prime - Stay Connected (main.py)",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "--program",
                "${workspaceFolder}\\main.py",
                "--stay-connected"
            ],
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": false,
            "env": {
                "PYTHONUNBUFFERED": "1"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true,
                "showReuseMessage": false
            },
            "program": "${workspaceFolder}\\cube_solver\\run_hub.py"
        },
        {
            "name": "SPIKE Prime - Run Once (main.py)",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "--program",
                "${workspaceFolder}\\main.py"
            ],
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": false,
            "env": {
                "PYTHONUNBUFFERED": "1"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true,
                "showReuseMessage": false
            },
            "program": "${workspaceFolder}\\cube_solver\\run_hub.py"
        }
    ]
}
